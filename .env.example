# ================================================================
# AI AD ENGINE — local credentials
# Powered by AI Blueprint
# ================================================================
# Copy this file to `.env` and fill in your values.
# Never commit `.env` — it is gitignored.
# Run `/config` in Claude Code to populate and test these automatically.
# ================================================================
#
# Claude Code IS the intelligence layer — no Anthropic or OpenAI LLM key is
# ever needed. All image generation routes through fal.ai (one key unlocks
# both Nano Banana 2 AND GPT Image 2).
# ================================================================


# ---------- V1 REQUIRED (3 keys) ----------

# FAL_KEY — FORGE uses this for image generation.
# fal.ai hosts BOTH Nano Banana 2 ($0.08/img, default, photorealistic) AND
# GPT Image 2 ($0.22/img, best text rendering). One key, both models.
# Get yours at https://fal.ai/dashboard/keys
FAL_KEY=

# META_ACCESS_TOKEN — powers the dashboard Overview tab's live ad insights.
# Use a System User token from Meta Business Manager:
#   https://business.facebook.com → Business Settings → System Users
# Required scopes: ads_read (minimum), plus ads_management + business_management
# (forward-compatible with V2 PUBLISHER). Set expiration to Never.
META_ACCESS_TOKEN=

# META_AD_ACCOUNT_ID — which ad account to read. Format: act_1234567890.
# Found in Ads Manager URL (the ?act= query param) or Business Settings.
META_AD_ACCOUNT_ID=


# ---------- V2 DEFERRED (skip unless prepping for a future release) ----------

# META_APP_ID — reserved for a future auto-publisher skill.
# No V1 code path reads this. Safe to leave blank.
META_APP_ID=

# META_PIXEL_ID — reserved for a future auto-publisher skill.
# No V1 code path reads this. Safe to leave blank.
META_PIXEL_ID=


# ---------- Local server ----------

PORT=3000
